{
	"$schema": "https://biomejs.dev/schemas/2.3.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error"
			},
			"suspicious": {
				"noShadowRestrictedNames": "error",
				"noExplicitAny": "warn"
			},
			"correctness": {
				"noSwitchDeclarations": "error",
				"useExhaustiveDependencies": "warn"
			},
			"complexity": {
				"useWhile": "error",
				"noForEach": "off"
			},
			"a11y": {
				"useButtonType": "error"
			}
		}
	},
	"javascript": {
		"globals": [
			"defineProps",
			"defineEmits",
			"defineExpose",
			"withDefaults",
			"ref",
			"computed",
			"watch",
			"onMounted",
			"onUnmounted",
			"onBeforeMount",
			"onUpdated",
			"onBeforeUpdate",
			"onBeforeUnmount",
			"inject",
			"provide",
			"reactive",
			"toRefs",
			"toRef",
			"isRef",
			"isReactive",
			"readonly"
		],
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all",
			"semicolons": "always"
		}
	}
}
